{
  "name": "@stan/core",
  "version": "0.1.0",
  "description": "Atomic state management library",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzesiekgs/stan.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.4",
    "vite-plugin-dts": "4.5.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
